            {
              "type": "null"
            }
          ]
        },
        "thumb": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "uri",
                "type",
                "revision"
              ],
              "properties": {
                "uri": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
