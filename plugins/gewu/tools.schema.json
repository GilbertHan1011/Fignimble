            "order",
            "align",
            "distribute",
            "match",
            "group",
            "ungroup",
            "figure",
            "style",
            "labels",
            "guide_add",
            "guide_move",
            "guide_delete",
            "guide_clear",
            "panel_text",
            "panel_text_style",
            "panel_text_reset",
            "panel_color",
            "make_layout",
            "release_layout",
            "divider",
            "crop",
            "rotate",
            "flip"
          ]
        },
        "oids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        }
