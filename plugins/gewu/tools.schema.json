  {
    "name": "edit",
    "description": "Change the figure with one native Fignimble operation: set, move, resize, endpoints, insert, delete, duplicate, order, align, distribute, match, group, ungroup, figure, style, labels, guide_*, panel_text*, panel_color, make_layout, release_layout, divider, crop, rotate, flip. OIDs are the ones in that preview and the write needs its revision.",
    "effect": "write",
    "target": "backend",
    "exposeToAgent": true,
    "inputSchema": {
      "type": "object",
      "additionalProperties": true,
