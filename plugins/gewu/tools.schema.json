[
  {
    "name": "state",
    "description": "List the project's figures, current revision, undo/redo and engine capabilities. Start here; every write needs the revision it returns.",
    "effect": "read",
    "target": "backend",
    "exposeToAgent": true,
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "project",
        "revision",
        "figures"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "canUndo": {
          "type": "boolean"
        },
        "canRedo": {
          "type": "boolean"
        },
        "undoLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "redoLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    }
  },
  {
    "name": "figure",
