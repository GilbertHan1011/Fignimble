  {
    "name": "new_figure",
    "description": "Create a figure file (and style.py when the project has none). An existing name is an error; nothing is renamed.",
    "effect": "write",
    "target": "backend",
    "exposeToAgent": true,
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "width",
        "height"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "journal": {
          "type": "string"
        },
        "expectedRevision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "figure",
        "revision"
      ],
      "properties": {
        "figure": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    }
  },
